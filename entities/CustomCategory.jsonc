{
  "name": "CustomCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Category Name"
    },
    "type": {
      "type": "string",
      "title": "Category Type",
      "enum": [
        "income",
        "surgical",
        "expense"
      ]
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
