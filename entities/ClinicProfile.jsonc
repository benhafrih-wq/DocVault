{
  "name": "ClinicProfile",
  "type": "object",
  "properties": {
    "clinic_name": {
      "type": "string",
      "title": "Clinic Name"
    },
    "currency": {
      "type": "string",
      "title": "Currency",
      "default": "DZD"
    }
  },
  "required": [
    "clinic_name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
